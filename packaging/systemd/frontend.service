[Unit]
Description=Bluetooth Frontend Service
After=network.target backend.service

[Service]
Type=simple
User=root
WorkingDirectory=@INSTALL_ROOT@/current/ework/Bluetooth/bt_frontend
ExecStart=/usr/bin/env node @INSTALL_ROOT@/current/ework/Bluetooth/bt_frontend/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=BT_BIN_DIR=@INSTALL_ROOT@/current/ework/Bluetooth/Bin
Environment=BT_LOG_DIR=@INSTALL_ROOT@/logs/Bluetooth

[Install]
WantedBy=multi-user.target
