[Unit]
Description=Vibration Gateway backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_ROOT@/current/ework/Bluetooth
ExecStart=@INSTALL_ROOT@/current/venv/bin/python -u bt_webapi_v3.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
