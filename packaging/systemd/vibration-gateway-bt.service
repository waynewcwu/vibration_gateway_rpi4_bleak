[Unit]
Description=Vibration Gateway Bluetooth collector
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=@INSTALL_ROOT@/current/ework/Bluetooth
ExecStart=@INSTALL_ROOT@/current/venv/bin/python -u bleak_v2q1.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
